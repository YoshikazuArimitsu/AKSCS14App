{
   "$schema": "https://alirezanet.github.io/Husky.Net/schema.json",
   "tasks": [
      {
         "name": "dotnet-format",
         "group": "pre-commit",
         "command": "dotnet",
         "args": [ "format", "AKSCS14App.slnx", "--include", "${staged}", "--no-restore" ],
         "include": [ "**/*.cs" ]
      }
   ]
}
